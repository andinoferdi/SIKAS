# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI / agent tooling (local-only, machine-specific)
.claude/
.serena/
.cursor/
.aider*
.codeium/
.continue/

# graphify knowledge graph (regenerate with `graphify`)
graphify-out/

# editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
desktop.ini

# secrets & credentials
*.key
*.pfx
*.p12
*.crt
secrets.json
.env.local
.env.*.local

# logs & caches
*.log
logs/
.cache/
.turbo/
.eslintcache
